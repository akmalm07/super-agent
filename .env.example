# Copy this file to .env. Values already in your terminal environment win.
# The harness never writes credentials, git identity, or GitHub identity.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GH_TOKEN=

# Internal role prompts are editable text templates, not Python strings.
# These paths are relative to this .env file. The included prompts/ directory
# contains planner.txt, chat_summary.txt, coder.txt, tester.txt, and
# structured_output.txt. Templates use $variable substitutions; write $$ for
# a literal dollar sign.
SUPER_AGENT_PROMPTS_DIRECTORY=prompts
# SUPER_AGENT_PLANNER_PROMPT_FILE=prompts/planner.txt
# SUPER_AGENT_CHAT_SUMMARY_PROMPT_FILE=prompts/chat_summary.txt
# SUPER_AGENT_CODER_PROMPT_FILE=prompts/coder.txt
# SUPER_AGENT_TESTER_PROMPT_FILE=prompts/tester.txt
# SUPER_AGENT_STRUCTURED_OUTPUT_PROMPT_FILE=prompts/structured_output.txt
